--- /dev/null
+++ b/libraries/nestjs-libraries/src/chat/tools/local.media.path.ts
@@ -0,0 +1,21 @@
+import path from 'path';
+import { realpath, stat } from 'fs/promises';
+
+export async function resolveAllowedLocalMediaPath(inputPath: string) {
+  const configuredRoot = process.env.POSTIZ_LOCAL_MEDIA_ROOT?.trim();
+  if (!configuredRoot) {
+    throw new Error('Local media ingestion is not configured.');
+  }
+  const root = await realpath(configuredRoot);
+  const candidate = path.isAbsolute(inputPath) ? inputPath : path.join(root, inputPath);
+  const resolved = await realpath(candidate);
+  const rootPrefix = root.endsWith(path.sep) ? root : root + path.sep;
+  if (resolved !== root && !resolved.startsWith(rootPrefix)) {
+    throw new Error('Path is outside the allowed local media root.');
+  }
+  const info = await stat(resolved);
+  if (!info.isFile()) {
+    throw new Error('Path is not a regular file.');
+  }
+  return { path: resolved, originalName: path.basename(resolved), size: info.size };
+}
