+++ b/scripts/backend-health-guard.cjs
@@ -0,0 +1,62 @@
+const net = require('net');
+const { spawnSync } = require('child_process');
+
+const STARTUP_GRACE_MS = Number(
+  process.env.POSTIZ_BACKEND_GUARD_GRACE_MS || 60000
+);
+const INTERVAL_MS = Number(
+  process.env.POSTIZ_BACKEND_GUARD_INTERVAL_MS || 15000
+);
+const FAILURES_BEFORE_RESTART = Number(
+  process.env.POSTIZ_BACKEND_GUARD_FAILURES || 3
+);
+const COOLDOWN_MS = Number(
+  process.env.POSTIZ_BACKEND_GUARD_COOLDOWN_MS || 120000
+);
+
+let failures = 0;
+let lastRestart = 0;
+
+function probe() {
+  return new Promise((resolve) => {
+    const socket = net.createConnection({ host: '127.0.0.1', port: 3000 });
+    const done = (ok) => {
+      socket.destroy();
+      resolve(ok);
+    };
+    socket.setTimeout(2500);
+    socket.once('connect', () => done(true));
+    socket.once('timeout', () => done(false));
+    socket.once('error', () => done(false));
+  });
+}
+
+async function check() {
+  const ok = await probe();
+  if (ok) {
+    failures = 0;
+    return;
+  }
+
+  failures += 1;
+  if (
+    failures >= FAILURES_BEFORE_RESTART &&
+    Date.now() - lastRestart >= COOLDOWN_MS
+  ) {
+    console.error(
+      '[backend-health-guard] backend port 3000 unavailable for ' +
+        failures +
+        ' checks; restarting backend'
+    );
+    spawnSync('pm2', ['restart', 'backend', '--update-env'], {
+      stdio: 'inherit',
+    });
+    lastRestart = Date.now();
+    failures = 0;
+  }
+}
+
+setTimeout(() => {
+  check();
+  setInterval(check, INTERVAL_MS);
+}, STARTUP_GRACE_MS);
-- 
