@@ -0,0 +1,58 @@
+import { AgentToolInterface } from '@gitroom/nestjs-libraries/chat/agent.tool.interface';
+import { createTool } from '@mastra/core/tools';
+import { z } from 'zod';
+import { Injectable } from '@nestjs/common';
+import { createReadStream } from 'fs';
+import { Readable } from 'stream';
+import { MediaService } from '@gitroom/nestjs-libraries/database/prisma/media/media.service';
+import { checkAuth } from '@gitroom/nestjs-libraries/chat/auth.context';
+import { UploadFactory } from '@gitroom/nestjs-libraries/upload/upload.factory';
+import { uploadStreamToStorage } from '@gitroom/nestjs-libraries/upload/custom.upload.validation';
+import { resolveAllowedLocalMediaPath } from '@gitroom/nestjs-libraries/chat/tools/local.media.path';
+
+@Injectable()
+export class UploadLocalMediaTool implements AgentToolInterface {
+  constructor(private _mediaService: MediaService) {}
+  name = 'uploadLocalMediaTool';
+  private storage = UploadFactory.createStorage();
+
+  available() {
+    return !!process.env.POSTIZ_LOCAL_MEDIA_ROOT;
+  }
+
+  run() {
+    return createTool({
+      id: 'uploadLocalMediaTool',
+      description: 'Import an image or MP4 video from the self-hosted server filesystem into the Postiz media library. Use this when the user gives a local path under the configured production-media root. The source is read-only and never moved or modified. Returns the Postiz-hosted media id and path that must be used as the attachment when scheduling.',
+      inputSchema: z.object({
+        path: z.string().min(1).describe('Absolute or root-relative local media path'),
+      }),
+      outputSchema: z.object({
+        id: z.string().optional(),
+        path: z.string().optional(),
+        originalName: z.string().optional(),
+        error: z.string().optional(),
+      }),
+      execute: async (inputData, context) => {
+        checkAuth(inputData, context);
+        try {
+          const org = JSON.parse((context?.requestContext as any)?.get('organization') as string);
+          const local = await resolveAllowedLocalMediaPath(inputData.path);
+          const nodeStream = createReadStream(local.path);
+          const webStream = Readable.toWeb(nodeStream) as any;
+          const uploaded = await uploadStreamToStorage(this.storage, webStream, local.size);
+          const media = await this._mediaService.saveFile(
+            org.id,
+            uploaded.filename,
+            uploaded.path,
+            local.originalName
+          );
+          return { id: media.id, path: media.path, originalName: local.originalName };
+        } catch (err) {
+          const message = err instanceof Error ? err.message : String(err);
+          return { error: 'Failed to import local media: ' + message };
+        }
+      },
+    });
+  }
+}
-- 
