+import { AgentToolInterface } from '@gitroom/nestjs-libraries/chat/agent.tool.interface';
+import { createTool } from '@mastra/core/tools';
+import { z } from 'zod';
+import { Injectable } from '@nestjs/common';
+import { IntegrationService } from '@gitroom/nestjs-libraries/database/prisma/integrations/integration.service';
+import { PostsService } from '@gitroom/nestjs-libraries/database/prisma/posts/posts.service';
+import { checkAuth } from '@gitroom/nestjs-libraries/chat/auth.context';
+
+@Injectable()
+export class ChannelAnalyticsTool implements AgentToolInterface {
+  constructor(private _integrationService: IntegrationService) {}
+  name = 'channelAnalyticsTool';
+
+  run() {
+    return createTool({
+      id: 'channelAnalyticsTool',
+      description:
+        'Fetch live provider analytics for a connected channel over the requested number of days. Use this before making claims about the channel actual performance.',
+      inputSchema: z.object({
+        integrationId: z.string().min(1),
+        days: z.number().int().min(1).max(365).optional().default(30),
+      }),
+      outputSchema: z.object({
+        output: z.any(),
+        error: z.string().optional(),
+      }),
+      execute: async (inputData, context) => {
+        checkAuth(inputData, context);
+        try {
+          const org = JSON.parse(
+            (context?.requestContext as any)?.get('organization') as string
+          );
+          return {
+            output: await this._integrationService.checkAnalytics(
+              org,
+              inputData.integrationId,
+              String(inputData.days)
+            ),
+          };
+        } catch (err) {
+          return {
+            output: [],
+            error:
+              'Failed to fetch channel analytics: ' +
+              (err instanceof Error ? err.message : String(err)),
+          };
+        }
+      },
+    });
+  }
+}
+
+@Injectable()
+export class PostAnalyticsTool implements AgentToolInterface {
+  constructor(private _postsService: PostsService) {}
+  name = 'postAnalyticsTool';
+
+  run() {
+    return createTool({
+      id: 'postAnalyticsTool',
+      description:
+        'Fetch live provider analytics for a published Postiz post. Use this to compare real post performance such as Instagram views/reach/shares/saves or YouTube views/likes/comments.',
+      inputSchema: z.object({
+        postId: z.string().min(1),
+        days: z.number().int().min(1).max(365).optional().default(30),
+      }),
+      outputSchema: z.object({
+        output: z.any(),
+        error: z.string().optional(),
+      }),
+      execute: async (inputData, context) => {
+        checkAuth(inputData, context);
+        try {
+          const orgId = JSON.parse(
+            (context?.requestContext as any)?.get('organization') as string
+          ).id;
+          return {
+            output: await this._postsService.checkPostAnalytics(
+              orgId,
+              inputData.postId,
+              inputData.days
+            ),
+          };
+        } catch (err) {
+          return {
+            output: [],
+            error:
+              'Failed to fetch post analytics: ' +
+              (err instanceof Error ? err.message : String(err)),
+          };
+        }
+      },
+    });
+  }
+}
