+++ b/libraries/nestjs-libraries/src/chat/tools/set.posting.times.tool.ts
@@ -0,0 +1,77 @@
+import { AgentToolInterface } from '@gitroom/nestjs-libraries/chat/agent.tool.interface';
+import { createTool } from '@mastra/core/tools';
+import { z } from 'zod';
+import { Injectable } from '@nestjs/common';
+import { IntegrationService } from '@gitroom/nestjs-libraries/database/prisma/integrations/integration.service';
+import { checkAuth } from '@gitroom/nestjs-libraries/chat/auth.context';
+import dayjs from 'dayjs';
+import utc from 'dayjs/plugin/utc';
+import timezone from 'dayjs/plugin/timezone';
+
+dayjs.extend(utc);
+dayjs.extend(timezone);
+
+@Injectable()
+export class SetPostingTimesTool implements AgentToolInterface {
+  constructor(private _integrationService: IntegrationService) {}
+  name = 'setPostingTimesTool';
+
+  run() {
+    return createTool({
+      id: 'setPostingTimesTool',
+      description:
+        'Set the native Postiz daily fallback posting times for one channel using local wall-clock times. The tool converts them to Postiz UTC minutes using the requested timezone. Use only when the user explicitly asks to change channel posting-time configuration; weekly best-day selection remains handled by nextPostingSlotTool.',
+      inputSchema: z.object({
+        integrationId: z.string().min(1),
+        localTimes: z
+          .array(z.string().regex(/^([01]\d|2[0-3]):[0-5]\d$/))
+          .min(1)
+          .max(8),
+        timezone: z.string().optional().default('Europe/Paris'),
+      }),
+      outputSchema: z.object({
+        localTimes: z.array(z.string()).optional(),
+        utcMinutes: z.array(z.number()).optional(),
+        timezone: z.string().optional(),
+        error: z.string().optional(),
+      }),
+      execute: async (inputData, context) => {
+        checkAuth(inputData, context);
+        try {
+          const orgId = JSON.parse(
+            (context?.requestContext as any)?.get('organization') as string
+          ).id;
+          const today = dayjs().tz(inputData.timezone).format('YYYY-MM-DD');
+          const utcMinutes = inputData.localTimes.map((time) => {
+            const local = dayjs.tz(
+              today + 'T' + time + ':00',
+              inputData.timezone
+            );
+            const converted = local.utc();
+            return converted.hour() * 60 + converted.minute();
+          });
+
+          await this._integrationService.setTimes(
+            orgId,
+            inputData.integrationId,
+            {
+              time: utcMinutes.map((time) => ({ time })),
+            } as any
+          );
+
+          return {
+            localTimes: inputData.localTimes,
+            utcMinutes,
+            timezone: inputData.timezone,
+          };
+        } catch (err) {
+          return {
+            error:
+              'Failed to set posting times: ' +
+              (err instanceof Error ? err.message : String(err)),
+          };
+        }
+      },
+    });
+  }
+}
