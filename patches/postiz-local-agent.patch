@@ -0,0 +1,61 @@
+import { AgentToolInterface } from '@gitroom/nestjs-libraries/chat/agent.tool.interface';
+import { createTool } from '@mastra/core/tools';
+import { z } from 'zod';
+import { Injectable } from '@nestjs/common';
+import { createReadStream } from 'fs';
+import axios from 'axios';
+import { checkAuth } from '@gitroom/nestjs-libraries/chat/auth.context';
+import { resolveAllowedLocalMediaPath } from '@gitroom/nestjs-libraries/chat/tools/local.media.path';
+
+@Injectable()
+export class TranscribeLocalMediaTool implements AgentToolInterface {
+  name = 'transcribeLocalMediaTool';
+
+  available() {
+    return !!process.env.POSTIZ_LOCAL_MEDIA_ROOT && !!process.env.POSTIZ_SPEACHES_URL;
+  }
+
+  run() {
+    return createTool({
+      id: 'transcribeLocalMediaTool',
+      description: 'Transcribe a local production video or audio file with the configured self-hosted Speaches server. Use this before writing captions or descriptions for a local video so the copy is grounded in what is actually said.',
+      inputSchema: z.object({
+        path: z.string().min(1).describe('Absolute or root-relative local media path'),
+        language: z.string().optional().describe('ISO language code, defaults to configured language'),
+      }),
+      outputSchema: z.object({
+        text: z.string().optional(),
+        error: z.string().optional(),
+      }),
+      execute: async (inputData, context) => {
+        checkAuth(inputData, context);
+        try {
+          const local = await resolveAllowedLocalMediaPath(inputData.path);
+          const base = process.env.POSTIZ_SPEACHES_URL!.replace(/\/+$/, '');
+          const model = process.env.POSTIZ_SPEACHES_MODEL || 'deepdml/faster-whisper-large-v3-turbo-ct2';
+          const language = inputData.language || process.env.POSTIZ_SPEACHES_LANGUAGE || 'fr';
+          const response = await axios.postForm(
+            base + '/v1/audio/transcriptions',
+            {
+              file: createReadStream(local.path),
+              model,
+              language,
+              response_format: 'json',
+            },
+            {
+              timeout: Number(process.env.POSTIZ_SPEACHES_TIMEOUT_MS || 900000),
+              maxBodyLength: Infinity,
+              maxContentLength: 16 * 1024 * 1024,
+            }
+          );
+          const text = String(response.data?.text || '').trim();
+          if (!text) throw new Error('Speaches returned an empty transcript.');
+          return { text };
+        } catch (err) {
+          const message = err instanceof Error ? err.message : String(err);
+          return { error: 'Failed to transcribe local media: ' + message };
+        }
+      },
+    });
+  }
+}
diff --git a/libraries/nestjs-libraries/src/chat/tools/upload.local.media.tool.ts b/libraries/nestjs-libraries/src/chat/tools/upload.local.media.tool.ts
