+export const metadata = { title: 'Terms of Service — Cloud9 Social' };
+
+export default function TermsPage() {
+  return (
+    <article className="space-y-7 text-[15px] leading-7 text-white/80">
+      <h1 className="text-4xl font-semibold text-white">Terms of Service</h1>
+      <p>
+        Effective September 28, 2026. These terms govern use of the publishing creator
+        Social, a web-based social-media publishing service.
+      </p>
+      <section>
+        <h2 className="text-xl font-semibold text-white">Authorized use</h2>
+        <p>
+          Users may connect only accounts they are authorized to control and may
+          publish only content they have the right to distribute. Users remain
+          responsible for captions, media, disclosures, privacy settings and
+          other publishing choices.
+        </p>
+      </section>
+      <section>
+        <h2 className="text-xl font-semibold text-white">TikTok publishing</h2>
+        <p>
+          TikTok accounts are connected through TikTok authorization. Before a
+          Direct Post, the service presents creator-specific posting options
+          supplied by TikTok. A post is submitted only after the user selects
+          the relevant settings and explicitly initiates or schedules
+          publication.
+        </p>
+      </section>
+      <section>
+        <h2 className="text-xl font-semibold text-white">Platform rules</h2>
+        <p>
+          Users must follow the destination platform&apos;s terms, community
+          rules, intellectual-property requirements and commercial-content
+          requirements. The service does not authorize conduct prohibited by
+          TikTok or any other connected platform.
+        </p>
+      </section>
+      <section>
+        <h2 className="text-xl font-semibold text-white">Availability</h2>
+        <p>
+          Publishing depends on third-party APIs and may be delayed, rejected or
+          unavailable when a platform changes its service, permissions or
+          limits. The application reports platform errors when available but
+          cannot guarantee delivery by third parties.
+        </p>
+      </section>
+      <section>
+        <h2 className="text-xl font-semibold text-white">Account control</h2>
+        <p>
+          Users may disconnect integrations and stop using the service at any
+          time. TikTok authorization may also be revoked directly from TikTok
+          account settings.
+        </p>
+      </section>
+      <section>
+        <h2 className="text-xl font-semibold text-white">Changes</h2>
+        <p>
+          These terms may be updated when the service or applicable requirements
+          change. Continued use after an update is subject to the current
+          version shown here.
+        </p>
+      </section>
+    </article>
+  );
+}
