+import Link from 'next/link';
+
+export const metadata = {
+  title: 'Cloud9 Social — Publishing platform',
+};
+
+export default function ReviewPage() {
+  return (
+    <article className="space-y-8 text-[15px] leading-7 text-white/80">
+      <section>
+        <p className="mb-3 text-sm font-medium uppercase tracking-[0.18em] text-white/45">
+          Social publishing
+        </p>
+        <h1 className="text-4xl font-semibold leading-tight text-white">
+          Create, review, schedule and publish your own social content.
+        </h1>
+        <p className="mt-5 max-w-3xl">
+          Cloud9 Social is a web-based publishing service for registered
+          creators and teams. Users connect their own social accounts and choose
+          the content, destination, privacy and publishing options for each
+          post.
+        </p>
+      </section>
+      <section className="rounded-2xl border border-white/10 p-6">
+        <h2 className="mb-3 text-xl font-semibold text-white">
+          TikTok integration
+        </h2>
+        <p>
+          The TikTok integration uses TikTok Login Kit and the Content Posting
+          API. It reads the connected creator&apos;s current posting
+          capabilities, presents TikTok&apos;s available privacy and interaction
+          choices, previews the selected content, and publishes only after the
+          user explicitly chooses to post.
+        </p>
+        <p className="mt-3">
+          The service never posts unrelated or promotional content on a
+          user&apos;s behalf. Users control the media, caption, disclosure
+          settings, privacy level and whether a post is sent directly to TikTok
+          or uploaded for completion inside TikTok.
+        </p>
+      </section>
+      <section className="grid gap-4 sm:grid-cols-3">
+        <div className="rounded-xl border border-white/10 p-5">
+          <strong className="text-white">Connect</strong>
+          <p className="mt-2">
+            Authorize your own TikTok account through TikTok OAuth.
+          </p>
+        </div>
+        <div className="rounded-xl border border-white/10 p-5">
+          <strong className="text-white">Review</strong>
+          <p className="mt-2">
+            Choose media, caption, privacy, interactions and disclosures.
+          </p>
+        </div>
+        <div className="rounded-xl border border-white/10 p-5">
+          <strong className="text-white">Publish</strong>
+          <p className="mt-2">
+            Explicitly submit the selected post or schedule it for your account.
+          </p>
+        </div>
+      </section>
+      <p>
+        <Link href="/auth" className="underline">
+          Register or sign in
+        </Link>{' '}
+        ·{' '}
+        <Link href="/privacy" className="underline">
+          Privacy Policy
+        </Link>{' '}
+        ·{' '}
+        <Link href="/terms" className="underline">
+          Terms of Service
+        </Link>
+      </p>
+    </article>
+  );
+}
