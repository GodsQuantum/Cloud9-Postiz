diff --git a/apps/frontend/src/app/(public)/privacy/page.tsx b/apps/frontend/src/app/(public)/privacy/page.tsx
new file mode 100644
index 0000000..e5dd988
--- /dev/null
+++ b/apps/frontend/src/app/(public)/privacy/page.tsx
@@ -0,0 +1,81 @@
+export const metadata = { title: 'Privacy Policy — Cloud9 Social' };
+
+export default function PrivacyPage() {
+  return (
+    <article className="space-y-7 text-[15px] leading-7 text-white/80">
+      <h1 className="text-4xl font-semibold text-white">Privacy Policy</h1>
+      <p>
+        Effective September 28, 2026. This policy describes the data handled by
+        Cloud9 Social when users connect social-media accounts and
+        publish content.
+      </p>
+      <section>
+        <h2 className="text-xl font-semibold text-white">Data we process</h2>
+        <p>
+          We process account identifiers, profile information returned by
+          connected platforms, OAuth credentials required to maintain authorized
+          connections, user-created posts and media, scheduling information, and
+          technical logs needed to operate and secure the service.
+        </p>
+      </section>
+      <section>
+        <h2 className="text-xl font-semibold text-white">TikTok data</h2>
+        <p>
+          For TikTok, we use only data and permissions authorized by the user
+          and required for account connection and Content Posting API features.
+          This includes creator information and posting capabilities used to
+          show the correct privacy, interaction and duration options before a
+          post is submitted.
+        </p>
+      </section>
+      <section>
+        <h2 className="text-xl font-semibold text-white">How data is used</h2>
+        <p>
+          Data is used to authenticate the user, display connected accounts,
+          prepare and preview user-selected content, schedule or publish that
+          content, report publishing status, and troubleshoot service errors. We
+          do not sell TikTok user data or use it for unrelated advertising.
+        </p>
+      </section>
+      <section>
+        <h2 className="text-xl font-semibold text-white">
+          Storage and security
+        </h2>
+        <p>
+          Connection data and publishing records are stored on infrastructure
+          controlled by the service operator and are protected by access
+          controls appropriate to the service. Access is limited to what is
+          needed to operate, secure and support the application.
+        </p>
+      </section>
+      <section>
+        <h2 className="text-xl font-semibold text-white">
+          Control and deletion
+        </h2>
+        <p>
+          Users can disconnect a social account from the service and can also
+          revoke TikTok authorization from their TikTok account settings. Users
+          may request deletion of account and associated service data through
+          the operator contact associated with this service.
+        </p>
+      </section>
+      <section>
+        <h2 className="text-xl font-semibold text-white">Third parties</h2>
+        <p>
+          Publishing necessarily sends the content and settings selected by the
+          user to the destination platform, including TikTok. Those platforms
+          process the submitted information under their own terms and privacy
+          policies.
+        </p>
+      </section>
+      <section>
+        <h2 className="text-xl font-semibold text-white">Changes</h2>
+        <p>
+          This policy may be updated when service functionality or legal
+          requirements change. The effective date above identifies the current
+          version.
+        </p>
+      </section>
+    </article>
+  );
+}
diff --git a/apps/frontend/src/app/(public)/review/page.tsx b/apps/frontend/src/app/(public)/review/page.tsx
