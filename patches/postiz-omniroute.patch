diff --git a/libraries/nestjs-libraries/src/openai/image.generator.ts b/libraries/nestjs-libraries/src/openai/image.generator.ts
new file mode 100644
index 0000000..2d8de87
--- /dev/null
+++ b/libraries/nestjs-libraries/src/openai/image.generator.ts
@@ -0,0 +1,99 @@
+import OpenAI from 'openai';
+
+const imageApiKey =
+  process.env.POSTIZ_IMAGE_API_KEY ||
+  process.env.OPENAI_API_KEY ||
+  'sk-proj-';
+const imageBaseUrl =
+  process.env.POSTIZ_IMAGE_BASE_URL || process.env.OPENAI_BASE_URL;
+const imageModel =
+  process.env.POSTIZ_IMAGE_MODEL || 'chatgpt-image-latest';
+
+const imageClient = new OpenAI({
+  apiKey: imageApiKey,
+  ...(imageBaseUrl ? { baseURL: imageBaseUrl } : {}),
+});
+
+type GeneratedImage = {
+  b64_json?: string | null;
+  url?: string | null;
+};
+
+function detectImageMime(base64: string): string {
+  const bytes = Buffer.from(base64, 'base64');
+  if (bytes.length >= 8 && bytes.subarray(0, 8).equals(Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]))) {
+    return 'image/png';
+  }
+  if (bytes.length >= 3 && bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff) {
+    return 'image/jpeg';
+  }
+  if (bytes.length >= 12 && bytes.subarray(0, 4).toString('ascii') === 'RIFF' && bytes.subarray(8, 12).toString('ascii') === 'WEBP') {
+    return 'image/webp';
+  }
+  if (bytes.length >= 6 && (bytes.subarray(0, 6).toString('ascii') === 'GIF87a' || bytes.subarray(0, 6).toString('ascii') === 'GIF89a')) {
+    return 'image/gif';
+  }
+  return 'image/png';
+}
+
+async function generate(
+  prompt: string,
+  isVertical = false
+): Promise<GeneratedImage> {
+  // Some Gemini image backends can occasionally return a successful HTTP
+  // response with an empty image list. Retry that specific transient once;
+  // real provider errors are already handled/fail-overed by OmniRoute.
+  for (let attempt = 0; attempt < 2; attempt += 1) {
+    const response = await imageClient.images.generate({
+      prompt,
+      model: imageModel,
+      size: isVertical ? '1024x1536' : '1024x1024',
+      response_format: 'b64_json',
+    } as any);
+
+    const rawResponse = response as unknown as
+      | { data?: GeneratedImage[] }
+      | GeneratedImage[];
+    const images = Array.isArray(rawResponse) ? rawResponse : rawResponse.data;
+    const image = images?.[0];
+    if (image) {
+      return image;
+    }
+  }
+
+  throw new Error('Image generation returned no image after one retry.');
+}
+
+export async function generateImageBase64(
+  prompt: string,
+  isVertical = false
+): Promise<string> {
+  const image = await generate(prompt, isVertical);
+  if (image.b64_json) {
+    return image.b64_json;
+  }
+  if (image.url) {
+    const response = await fetch(image.url);
+    if (!response.ok) {
+      throw new Error(
+        'Image generation URL fetch failed (' + response.status + ').'
+      );
+    }
+    return Buffer.from(await response.arrayBuffer()).toString('base64');
+  }
+  throw new Error('Image generation returned neither base64 nor URL.');
+}
+
+export async function generateImageSource(
+  prompt: string,
+  isVertical = false
+): Promise<string> {
+  const image = await generate(prompt, isVertical);
+  if (image.b64_json) {
+    return 'data:' + detectImageMime(image.b64_json) + ';base64,' + image.b64_json;
+  }
+  if (image.url) {
+    return image.url;
+  }
+  throw new Error('Image generation returned neither base64 nor URL.');
+}
